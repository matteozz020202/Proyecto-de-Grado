# Configuración OpenAI exclusivamente del servidor; completar en .env o entorno.
OPENAI_API_KEY=
OPENAI_MODEL=

# Desarrollo local con Wompi Sandbox. Nunca uses llaves de producción.
WOMPI_CHECKOUT_ENABLED=False
# Producción/Preview: https://proyecto-de-grado-eight.vercel.app
WOMPI_PUBLIC_BASE_URL=
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=

# Origen temporal HTTPS de ngrok, sin ruta ni barra final.
# Solo se admite con DEBUG=True. Ejemplo ficticio:
# LOCAL_TUNNEL_URL=https://example.ngrok-free.dev
LOCAL_TUNNEL_URL=
